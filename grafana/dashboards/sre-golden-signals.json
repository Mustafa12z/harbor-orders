    {
      "id": 12,
      "type": "timeseries",
      "title": "Saturation \u2014 estimated in-flight requests",
      "description": "Little\u2019s Law approximation: concurrency \u2248 arrival rate \u00d7 mean latency.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 31
