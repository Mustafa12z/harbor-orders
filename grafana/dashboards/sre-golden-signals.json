      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval]))",
          "legendFormat": "rps",
