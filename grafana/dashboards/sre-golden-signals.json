        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (\n  rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval])\n  *\n  (\n    sum by (service_name) (rate(traces_span_metrics_duration_seconds_sum{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval]))\n    /\n    clamp_min(sum by (service_name) (rate(traces_span_metrics_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval])), 1e-9)\n  )\n)",
