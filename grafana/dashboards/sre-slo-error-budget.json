{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud Prometheus / Mimir (span metrics)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Availability and latency SLIs/SLOs with 30d error budget and burn rates.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "sre",
        "orders"
      ],
      "targetBlank": false,
      "title": "Other SRE dashboards",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "SLIs, SLOs, and error budgets",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Based on [SRE Book \u2014 Service Level Objectives](https://sre.google/sre-book/service-level-objectives/) and [Workbook \u2014 Implementing SLOs](https://sre.google/workbook/implementing-slos/).\n\n| SLI | Definition (this stack) |\n|-----|-------------------------|\n| **Availability** | Fraction of server spans without `status=ERROR` |\n| **Latency** | Fraction of server spans faster than the latency threshold (histogram) |\n\n**Error budget** = `1 \u2212 SLO`. Burn it when reality is worse than the objective.\nTune thresholds with the dashboard variables (defaults: 99.9% availability, p99 < 500ms)."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Availability SLI / SLO",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "collapsed": false
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Availability SLI % (5m)",
      "description": "Success ratio vs configured availability SLO.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (\n  1 - (\n    sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\",status_code=~\"(?i)(STATUS_CODE_)?ERROR\"}[$__rate_interval]))\n    /\n    clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval])), 1e-9)\n  )\n)",
          "legendFormat": "availability",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "vector($availability_slo)",
          "legendFormat": "SLO",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percent",
          "min": 95
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Availability (30d window)",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (\n  1 - (\n    sum(increase(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\",status_code=~\"(?i)(STATUS_CODE_)?ERROR\"}[30d]))\n    /\n    clamp_min(sum(increase(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[30d])), 1)\n  )\n)",
          "legendFormat": "30d",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error budget remaining %",
      "description": "Remaining share of the 30d availability error budget.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "clamp_min(\n  100 * (\n    (\n      (1 - $availability_slo/100)\n      - (\n        sum(increase(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\",status_code=~\"(?i)(STATUS_CODE_)?ERROR\"}[30d]))\n        /\n        clamp_min(sum(increase(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[30d])), 1)\n      )\n    )\n    /\n    clamp_min(1 - $availability_slo/100, 1e-9)\n  )\n, 0)",
          "legendFormat": "budget",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Latency SLI / SLO",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency SLI % under threshold",
      "description": "Share of requests completing within the latency threshold.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (\n  sum(rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\",le=\"$latency_slo_seconds\"}[$__rate_interval]))\n  /\n  clamp_min(sum(rate(traces_span_metrics_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval])), 1e-9)\n)",
          "legendFormat": "fast enough",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "vector($latency_slo_percentile * 100)",
          "legendFormat": "SLO",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percent",
          "min": 90
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Observed latency quantile vs SLO threshold",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile($latency_slo_percentile, sum by (le) (rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[$__rate_interval])))",
          "legendFormat": "observed",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "vector($latency_slo_seconds)",
          "legendFormat": "threshold",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Burn rates (multi-window)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Availability error-budget burn rate",
      "description": "Burn rate > 1 means consuming error budget faster than the 30d allowance. Multi-window alerting idea from the SRE Workbook.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\",status_code=~\"(?i)(STATUS_CODE_)?ERROR\"}[1h]))\n  /\n  clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[1h])), 1e-9)\n)\n/\nclamp_min(1 - $availability_slo/100, 1e-9)",
          "legendFormat": "1h burn",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\",status_code=~\"(?i)(STATUS_CODE_)?ERROR\"}[6h]))\n  /\n  clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",deployment_environment=~\"$environment\",span_kind=~\"(?i)(SPAN_KIND_)?SERVER\"}[6h])), 1e-9)\n)\n/\nclamp_min(1 - $availability_slo/100, 1e-9)",
          "legendFormat": "6h burn",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "vector(1)",
          "legendFormat": "budget pace (1x)",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "vector(14.4)",
          "legendFormat": "fast burn ~1h to empty (14.4x)",
          "range": true,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "sre",
