project_id    = "YOUR_GCP_PROJECT_ID"
region        = "europe-west2"
zone          = "europe-west2-a"
cluster_name  = "staging"
k8s_namespace = "orders-staging"

# Public hostname (Route 53 A record + ManagedCertificate). Leave empty to skip.
# domain_name       = "staging.order.mustafamirreh.com"
# route53_zone_id   = "Z07782661B5WKHOHAEPWD"
# route53_zone_name = "mustafamirreh.com"  # used if zone id omitted

# Cloud Monitoring alerts (email). Leave empty to skip policies.
# alert_email = "you@example.com"

# Grafana Cloud OTLP (enables Alloy + traces). Leave empty to skip.
# grafana_otlp_endpoint = "https://otlp-gateway-prod-eu-west-2.grafana.net/otlp"
# grafana_instance_id   = "123456"
# grafana_api_token     = "glc_..."

# Replace with your public IP/32, e.g. "203.0.113.10/32"
master_authorized_cidrs = [
  {
    cidr_block   = "0.0.0.0/0"
    display_name = "staging-open-replace-with-your-ip"
  }
]

# --- Multi-environment placement ---------------------------------------------
# When staging shares the dev GCP project, name_suffix keeps every project-scoped
# resource distinct (orders-worker-staging, order-events-staging,
# orders-staging-jwt-secret, gke-orders-staging-vpc) and dev remains the owner of
# the shared Artifact Registry repository. If you later give staging its own
# project, set name_suffix = "" and manage_project_singletons = true.
# name_suffix               = "-staging"
# manage_project_singletons = false
