project_id    = "YOUR_GCP_PROJECT_ID"
region        = "europe-west2"
zone          = "europe-west2-a"
cluster_name  = "dev"
k8s_namespace = "orders"

# Public hostname (Route 53 A record + ManagedCertificate). Leave empty to skip.
# domain_name       = "dev.order.mustafamirreh.com"
# argocd_domain_name = "argocd.dev.order.mustafamirreh.com"  # default: argocd.<domain_name>
# route53_zone_id   = "Z07782661B5WKHOHAEPWD"
# route53_zone_name = "mustafamirreh.com"  # used if zone id omitted

# Cloud Monitoring alerts (email). Leave empty to skip policies.
# alert_email = "you@example.com"

# Grafana Cloud OTLP (enables Alloy + traces). Leave empty to skip.
# grafana_otlp_endpoint = "https://otlp-gateway-prod-eu-west-2.grafana.net/otlp"
# grafana_instance_id   = "123456"
# grafana_api_token     = "glc_..."

# Replace with your public IP/32, e.g. "203.0.113.10/32"
master_authorized_cidrs = [
  {
    cidr_block   = "0.0.0.0/0"
    display_name = "dev-open-replace-with-your-ip"
  }
]

# --- Multi-environment placement ---------------------------------------------
# dev is the singleton owner: it manages the shared Artifact Registry
# repository. name_suffix is empty so dev resource names stay as originally created.
# name_suffix               = ""
# manage_project_singletons = true
